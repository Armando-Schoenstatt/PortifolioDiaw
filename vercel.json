{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ArmandoMoreira": {
      "root": ".",
      "framework": "vite"
    },
    "contributorstats": {
      "root": "apps/ContributorStats",
      "framework": "vite",
      "buildCommand": "npm run build -- --outDir dist",
      "outputDirectory": "dist"
    },
    "espn_api": {
      "root": "apps/ESPN_API",
      "framework": "vite",
      "buildCommand": "npm run build -- --outDir dist",
      "outputDirectory": "dist"
    },
    "reactbits": {
      "root": "apps/ReactBits",
      "framework": "vite",
      "buildCommand": "npm run build -- --outDir dist",
      "outputDirectory": "dist"
    },
    "wakatimeapi": {
      "root": "apps/WakaTimeAPI",
      "framework": "vite",
      "buildCommand": "npm run build -- --outDir dist",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "ArmandoMoreira"
      }
    }
  ]
}
