{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "armando-moreira": {
      "root": ".",
      "framework": "vite"
    },
    "contributor-stats": {
      "root": "apps/ContributorStats",
      "framework": "vite",
      "buildCommand": "npm run build -- --outDir dist",
      "outputDirectory": "dist"
    },
    "espn-api": {
      "root": "apps/ESPN_API",
      "framework": "vite",
      "buildCommand": "npm run build -- --outDir dist",
      "outputDirectory": "dist"
    },
    "reactbits": {
      "root": "apps/ReactBits",
      "framework": "vite",
      "buildCommand": "npm run build -- --outDir dist",
      "outputDirectory": "dist"
    },
    "wakatime-api": {
      "root": "apps/WakaTimeAPI",
      "framework": "vite",
      "buildCommand": "npm run build -- --outDir dist",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "armando-moreira"
      }
    }
  ]
}
